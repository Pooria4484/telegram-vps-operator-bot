{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary_short",
    "summary_full",
    "what_changed",
    "changed_files",
    "checks",
    "result_for_user",
    "next_steps",
    "needs_user_input",
    "user_input_question",
    "debug"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ]
    },
    "summary_short": {
      "type": "string"
    },
    "summary_full": {
      "type": "string"
    },
    "what_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "change_type",
          "summary"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "change_type": {
            "type": "string",
            "enum": [
              "created",
              "modified",
              "deleted"
            ]
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "details"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "result_for_user": {
      "type": "string"
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs_user_input": {
      "type": "boolean"
    },
    "user_input_question": {
      "type": "string"
    },
    "debug": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands_run",
        "notes"
      ],
      "properties": {
        "commands_run": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
